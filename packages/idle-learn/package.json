{
  "name": "@mblarsen/pi-idle-learn",
  "version": "0.1.0",
  "description": "Learn from idle Pi sessions and review proposed project instruction changes.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "*.ts",
    "!*.test.ts",
    "worker-launcher.mjs",
    "reviewer-prompt.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mblarsen/pi-extensions.git",
    "directory": "packages/idle-learn"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.3",
    "@earendil-works/pi-coding-agent": ">=0.84.3",
    "@earendil-works/pi-tui": ">=0.84.3"
  },
  "dependencies": {
    "boxen": "^9.0.0",
    "jiti": "^2.7.0",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "^1.4.2",
    "typebox": "^1.3.7"
  },
  "author": "Michael Bøcker-Larsen"
}
